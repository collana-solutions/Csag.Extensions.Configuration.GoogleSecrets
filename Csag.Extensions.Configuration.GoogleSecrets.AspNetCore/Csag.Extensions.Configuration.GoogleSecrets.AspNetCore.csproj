<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<Version>2.0.0</Version>
		<Description>Registers the Csag.Extensions.Configuration.GoogleSecrets configuration provider on an ASP.NET Core WebApplicationBuilder with one call to AddGoogleSecrets.</Description>
		<PackageTags>configuration google-cloud secret-manager secrets aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Csag.Extensions.Configuration.GoogleSecrets\Csag.Extensions.Configuration.GoogleSecrets.csproj" />
	</ItemGroup>

</Project>