<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Csag.Extensions.Configuration.GoogleSecrets</RootNamespace>
    <PackageId>Csag.Extensions.Configuration.GoogleSecrets</PackageId>
    <Version>1.6.0</Version>
    <Product>Add Google Secrets to the Configuration</Product>
    <Description>A Microsoft.Extensions.Configuration provider that loads secrets from Google Cloud Secret Manager into IConfiguration, and resolves {GoogleSecret:SecretName:Version} placeholders in existing configuration values.</Description>
    <PackageTags>configuration google-cloud secret-manager secrets</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.SecretManager.V1" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

</Project>
